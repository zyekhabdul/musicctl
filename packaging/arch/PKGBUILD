# Maintainer: Zyekh Abdul <zyekhabdul@users.noreply.github.com>

pkgname=musicctl
pkgver=1.1.0
pkgrel=1
pkgdesc="Lightweight standalone YouTube Music CLI & TUI player (mpv + yt-dlp + fzf)"
arch=('any')
url="https://github.com/zyekhabdul/musicctl"
license=('MIT')
depends=(
    'bash'
    'curl'
    'fzf'
    'jq'
    'mpv'
    'python'
    'yt-dlp'
)
optdepends=(
    'chafa: Terminal album art preview'
    'libnotify: Desktop track notifications'
    'mpv-mpris: Native MPRIS media keys integration'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm755 bin/musicctl "$pkgdir/usr/bin/musicctl"
    install -Dm644 completions/musicctl.bash "$pkgdir/usr/share/bash-completion/completions/musicctl"
    install -Dm644 completions/_musicctl "$pkgdir/usr/share/zsh/site-functions/_musicctl"
    install -Dm644 musicctl.desktop "$pkgdir/usr/share/applications/musicctl.desktop"
    install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGELOG.md
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
