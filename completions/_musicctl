#compdef musicctl

_musicctl() {
  local -a commands
  commands=(
    'tui:Launch interactive clickable Sovereign Dashboard'
    'fzf:Launch legacy fzf TUI cockpit with realtime preview'
    'play:Resolve track, album/playlist ref, or file and play'
    'add:Resolve track, album/playlist ref, or file and enqueue'
    'search:Search catalogs (ytm|deezer|itunes)'
    'browse:Browse album, artist, or playlist entity'
    'radio:Queue YTM Up Next Radio mix'
    'toggle:Toggle play/pause'
    'pause:Toggle play/pause'
    'next:Next track in queue'
    'prev:Previous track in queue'
    'jump:Jump to 1-based queue index'
    'move:Reorder queue item position'
    'remove:Remove 1-based queue item'
    'clear:Clear upcoming queue items'
    'shuffle:Shuffle active mpv queue'
    'loop:Cycle or set repeat mode'
    'mute:Toggle mute'
    'quality:Set audio quality tier and provider priority'
    'eq:Set parametric EQ preset'
    'norm:Toggle EBU R128 loudness normalization'
    'autoplay:Toggle infinite Up Next Radio autoplay'
    'speed:Set playback speed'
    'vol:Set or adjust volume'
    'seek:Relative seek in seconds'
    'status:Show playback status or Waybar JSON'
    'queue:List active mpv queue'
    'lyrics:Fetch lyrics via LRCLIB'
    'download:Download audio offline (FLAC/M4A/Opus)'
    'dl:Download audio offline (FLAC/M4A/Opus)'
    'local:List/search local audio library (flat|artist|album)'
    'pl:Manage named local playlists'
    'sleep:Set or cancel auto-stop sleep timer'
    'resume:Restore saved queue and playback position'
    'save:Snapshot current queue and position'
    'cache:Inspect or clear audio/art cache'
    'history:Show playback history'
    'fav:Manage local favorites'
    'doctor:Check dependencies, MPRIS, daemon, and cache'
    'stop:Save session and stop daemon'
    'version:Print version'
    'help:Show help message'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  case "$words[2]" in
    fav)
      if (( CURRENT == 3 )); then
        _values 'subcommand' list ls add rm del play
      fi
      ;;
    pl|playlist)
      if (( CURRENT == 3 )); then
        _values 'subcommand' ls list create add show play move sync import rm delete
      elif (( CURRENT == 4 )); then
        local pdir="${MUSICCTL_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/musicctl}/playlists"
        if [[ -d "$pdir" ]]; then
          local -a pls
          pls=(${(f)"$(find "$pdir" -maxdepth 1 -type f -name '*.tsv' -printf '%f\n' 2>/dev/null | sed 's/\.tsv$//')"})
          _describe 'playlist' pls
        fi
      fi
      ;;
    loop|repeat)
      _values 'mode' off one all cycle
      ;;
    sleep)
      _values 'sleep' off status 15 30 45 60
      ;;
    cache)
      _values 'action' status clear
      ;;
    lyrics)
      _values 'option' --live
      ;;
    status)
      _values 'option' --json
      ;;
    clear)
      _values 'option' --all
      ;;
    eq)
      _values 'preset' flat bass warm vocal bright rock cycle status
      ;;
    quality)
      _values 'tier' small cd hires ask cycle status
      ;;
    norm)
      _values 'action' on off toggle status
      ;;
    search)
      if [[ "$words[CURRENT-1]" == "--catalog" || "$words[CURRENT-1]" == "-c" ]]; then
        _values 'catalog' ytm deezer itunes
      elif [[ "$words[CURRENT-1]" == "--type" || "$words[CURRENT-1]" == "-t" ]]; then
        _values 'type' songs albums artists playlists
      elif [[ "$words[CURRENT]" == -* ]]; then
        _values 'option' --catalog --type --json
      fi
      ;;
    browse)
      if [[ "$words[CURRENT]" == -* ]]; then
        _values 'option' --json --tsv
      fi
      ;;
    autoplay)
      _values 'action' on off toggle status
      ;;
    local)
      if [[ "$words[CURRENT-1]" == "--by" ]]; then
        _values 'group' flat artist album
      elif [[ "$words[CURRENT]" == -* ]]; then
        _values 'option' --by --rescan --json
      fi
      ;;
    dl|download)
      if [[ "$words[CURRENT-1]" == "--quality" || "$words[CURRENT-1]" == "-q" ]]; then
        _values 'tier' small cd hires ask
      elif [[ "$words[CURRENT-1]" == "--format" || "$words[CURRENT-1]" == "-f" ]]; then
        _values 'format' auto flac opus m4a mp3
      elif [[ "$words[CURRENT-1]" == "--jobs" || "$words[CURRENT-1]" == "-j" ]]; then
        _values 'jobs' 1 2 3 4
      elif [[ "$words[CURRENT]" == -* ]]; then
        _values 'option' --quality -q --format -f --jobs -j --template -t --lrc --replaygain --force --dry-run --prune --jsonl --json
      else
        _values 'subcommand' sync status cancel current
      fi
      ;;
    play|add)
      _files
      ;;
  esac
}

_musicctl "$@"
